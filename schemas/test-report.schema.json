{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-platform/schemas/test-report.schema.json",
  "title": "测试/检查报告协议",
  "description": "依据规范 §7.4（命令/版本/退出码/摘要/产物位置）与 §16.5（通过/失败/未验证/不适用四态区分；UNVERIFIED 必须给出原因）。",
  "type": "object",
  "required": ["schema_version", "report_id", "task_id", "tool", "command", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "report_id": { "type": "string", "pattern": "^TRUN-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "tool_version": { "type": "string", "default": "" },
    "command": { "type": "string" },
    "exit_code": { "type": ["integer", "null"], "default": null },
    "status": { "enum": ["PASSED", "FAILED", "UNVERIFIED", "NOT_APPLICABLE"] },
    "total": { "type": "integer", "minimum": 0, "default": 0 },
    "passed": { "type": "integer", "minimum": 0, "default": 0 },
    "failed": { "type": "integer", "minimum": 0, "default": 0 },
    "skipped": { "type": "integer", "minimum": 0, "default": 0 },
    "not_run": { "type": "integer", "minimum": 0, "default": 0 },
    "artifact_path": { "type": "string", "default": "" },
    "unverified_reason": { "type": "string", "default": "" },
    "started_at": { "type": "string", "default": "" },
    "finished_at": { "type": "string", "default": "" },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "if": {
    "properties": { "status": { "const": "UNVERIFIED" } }
  },
  "then": {
    "properties": {
      "unverified_reason": { "minLength": 1 }
    },
    "required": ["unverified_reason"]
  },
  "additionalProperties": false
}
