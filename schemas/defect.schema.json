{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-dev-platform/schemas/defect.schema.json",
  "title": "缺陷协议",
  "description": "依据规范 §16.3 严重度量表与缺陷生命周期（OPEN→IN_FIX→FIXED→VERIFIED→CLOSED）。",
  "type": "object",
  "required": ["schema_version", "defect_id", "task_id", "severity", "title", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "defect_id": { "type": "string", "pattern": "^DEF-[A-Za-z0-9][A-Za-z0-9-]*$" },
    "task_id": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["BLOCKER", "CRITICAL", "MAJOR", "MINOR", "INFO"] },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OPEN", "IN_FIX", "FIXED", "VERIFIED", "CLOSED"] },
    "source": { "enum": ["REVIEW", "TEST", "MANUAL"], "default": "MANUAL" },
    "description": { "type": "string", "default": "" },
    "root_cause": { "type": "string", "default": "" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "version": { "type": "integer", "minimum": 1, "default": 1 },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
