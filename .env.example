# 环境变量模板：复制为 .env 并填入真实值；.env 不入库、不入日志。
# 所有密钥一律通过环境变量或系统凭据库注入（config/policies.yaml secrets 节）。

# --- 模型接入（云端 OpenAI 兼容 API，Phase 4 起启用） ---
AI_DEV_PLATFORM_MODEL_BASE_URL=
AI_DEV_PLATFORM_MODEL_API_KEY=
AI_DEV_PLATFORM_MODEL_NAME=

# --- 平台运行（可选，均有内置默认值） ---
AI_DEV_PLATFORM_WORKSPACE_ROOT=
AI_DEV_PLATFORM_LOG_LEVEL=INFO
